//go:build ignore

//kage:unit pixels

package shaders

// Fragment renders a particle whose color is fully evaluated on the CPU.
// Vertex data layout:
// - color.rgb: tint (straight alpha)
// - color.a:   alpha
// - custom.x:  normalized lifetime (0-1), for time-based effects
//
// This shader reproduces the default (shader-less) DrawTriangles path and
// serves as the starting point for custom particle shaders.
func Fragment(dstPos vec4, srcPos vec2, color vec4, custom vec4) vec4 {
	tex := imageSrc0At(srcPos)
	return vec4(tex.rgb*color.rgb*color.a, tex.a*color.a)
}
