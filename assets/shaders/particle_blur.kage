//go:build ignore

//kage:unit pixels

package shaders

// Fragment renders a particle with a soft blur that widens over its lifetime.
// Vertex data layout:
// - color.rgb: tint (straight alpha)
// - color.a:   alpha
// - custom.x:  normalized lifetime (0-1)
func Fragment(dstPos vec4, srcPos vec2, color vec4, custom vec4) vec4 {
	normalizedT := custom.x
	alpha := color.a
	tintColor := color.rgb

	// Soft blur radius grows over lifetime for a dissipating look.
	radius := 0.6 + normalizedT*2.2

	c := imageSrc0At(srcPos) * 0.24
	c += imageSrc0At(srcPos+vec2(radius, 0.0)) * 0.12
	c += imageSrc0At(srcPos-vec2(radius, 0.0)) * 0.12
	c += imageSrc0At(srcPos+vec2(0.0, radius)) * 0.12
	c += imageSrc0At(srcPos-vec2(0.0, radius)) * 0.12
	c += imageSrc0At(srcPos+vec2(radius, radius)) * 0.07
	c += imageSrc0At(srcPos+vec2(radius, -radius)) * 0.07
	c += imageSrc0At(srcPos+vec2(-radius, radius)) * 0.07
	c += imageSrc0At(srcPos-vec2(radius, radius)) * 0.07

	a := c.a * alpha
	blurred := vec4(c.rgb*tintColor*a, a)

	core := imageSrc0At(srcPos)
	coreA := core.a * alpha * (1.0 - normalizedT*0.35)
	coreCol := vec4(core.rgb*tintColor*coreA, coreA)

	return vec4(blurred.rgb+coreCol.rgb*0.35, max(blurred.a, coreCol.a))
}
